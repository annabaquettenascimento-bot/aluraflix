<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;700&display=swap" rel="stylesheet">
    <title>ANNATUBE</title>
    <style>
        /* Estilos gerais para o corpo da página */
        body {
            font-family: 'Chakra Petch', sans-serif;
            background: linear-gradient(to bottom, #8A2BE2, #4B0082); /* Gradiente de tons de roxo */
            color: #FFFFFF;
            margin: 0;
            padding: 0;
        }

        /* Estilo do cabeçalho */
        header {
            background-color: #2c003e; /* Roxo bem escuro */
            padding: 20px 0;
            text-align: center;
            font-size: 2.5em;
            font-weight: 700;
            color: #c3a1e1; /* Roxo claro para contraste */
            text-transform: uppercase;
            letter-spacing: 4px;
            border-bottom: 2px solid #c3a1e1; /* Roxo claro para contraste */
        }

        /* Seção de chamada (vídeo em destaque) */
        .chamada {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            gap: 20px;
            text-align: center;
        }

        .chamada-link {
            text-decoration: none;
            color: inherit;
            transition: transform 0.3s ease;
            display: inline-block;
        }
        
        .chamada-link:hover {
            transform: scale(1.05);
        }

        .chamada-texto h1 {
            font-size: 2.2em;
            margin: 0 0 10px 0;
            color: #FFFFFF;
        }

        .chamada-texto p {
            font-size: 1.2em;
            color: #f0f0f0;
            margin: 0;
        }

        /* Estilo do Iframe para ser responsivo */
        .video-container {
            position: relative;
            width: 100%;
            max-width: 640px; /* Largura máxima do vídeo */
            padding-bottom: 56.25%; /* Proporção 16:9 */
            height: 0;
        }
        .video-container iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: 8px;
        }

        /* Seção de categoria de vídeos */
        .categoria {
            padding: 20px 40px;
        }

        .categoria h2 {
            font-size: 1.8em;
            border-bottom: 2px solid #c3a1e1; /* Roxo claro para combinar */
            padding-bottom: 10px;
            margin-bottom: 30px;
        }

        /* Grid para os vídeos da categoria */
        .categoria-videos {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 20px;
        }

        .categoria-videos a {
            display: block;
            border-radius: 8px;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .categoria-videos a:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.5);
        }

        .categoria-videos img {
            width: 100%;
            height: auto;
            display: block;
        }
        
        /* Responsividade para telas menores */
        @media (min-width: 768px) {
            .chamada {
                flex-direction: row;
                text-align: left;
                gap: 40px;
            }
        }

    </style>
</head>

<body>
    <!-- Cabeçalho da página -->
    <header>ANNATUBE</header>

    <!-- Seção do vídeo em destaque -->
    <section class="chamada">
        <a href="https://www.youtube.com/watch?v=yAZxx8t9zig" target="_blank" class="chamada-link">
            <div class="chamada-texto">
                <h1>Divertidamente 2</h1>
                <p>#animação #familia</p>
            </div>
        </a>

        <div class="video-container">
            <iframe src="https://www.youtube.com/embed/k9CR_p-n-Y4?si=nC2P8p0cO1n1_R1a"
                title="YouTube video player" frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
    </section>

    <!-- Seção com a galeria de filmes e séries -->
    <section class="categoria">
        <h2>Filmes e séries</h2>
        <div class="categoria-videos">
            <!-- Link e imagem para Duna: Parte 2 -->
            <a href="https://www.youtube.com/watch?v=U2Qp5pL3ovA" target="_blank">
                <img src="https://img.youtube.com/vi/U2Qp5pL3ovA/maxresdefault.jpg" alt="Duna: Parte 2" />
            </a>
            <!-- Link e imagem para Oppenheimer -->
            <a href="https://www.youtube.com/watch?v=F1eO-O3b-lQ" target="_blank">
                <img src="https://img.youtube.com/vi/F1eO-O3b-lQ/maxresdefault.jpg" alt="Oppenheimer" />
            </a>
            <!-- Link e imagem para Barbie -->
            <a href="https://www.youtube.com/watch?v=pBk4NYhWNMM" target="_blank">
                <img src="https://img.youtube.com/vi/pBk4NYhWNMM/maxresdefault.jpg" alt="Barbie" />
            </a>
            <!-- Link e imagem para Vingadores: Ultimato -->
            <a href="https://www.youtube.com/watch?v=g6ng8eQGgK8" target="_blank">
                <img src="https://img.youtube.com/vi/g6ng8eQGgK8/maxresdefault.jpg" alt="Vingadores: Ultimato" />
            </a>
            <!-- Link e imagem para O Protetor 3 -->
            <a href="https://www.youtube.com/watch?v=9pgjF53aLhI" target="_blank">
                <img src="https://img.youtube.com/vi/9pgjF53aLhI/maxresdefault.jpg" alt="O Protetor 3" />
            </a>
        </div>
    </section>

</body>

</html>


